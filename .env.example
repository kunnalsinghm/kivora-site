# Local use: copy to .env and edit (npm start loads it). Never commit .env.
# On Vercel, set these under Project > Settings > Environment Variables instead.
PORT=3000
HOST=127.0.0.1
TRUST_PROXY=0

# Leave empty locally to use a SQLite file in ./data. On Vercel this is set for you by the Neon integration.
DATABASE_URL=
DB_PATH=./data/waitlist.db

# Long random string. Enables /admin and the CSV export. Empty = disabled.
ADMIN_TOKEN=
# Any random string: used to hash visitor IPs for rate limiting (so raw IPs are never stored).
IP_SALT=

# Email alert for each sign-up (Gmail needs 2-step verification and an App Password, not your normal password).
GMAIL_USER=connect.kivora@gmail.com
GMAIL_APP_PASSWORD=
NOTIFY_TO=

# Optional: public address, used in sitemap.xml. Normally detected from the request.
SITE_URL=
